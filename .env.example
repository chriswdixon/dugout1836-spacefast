# Spacefast Functions worker secrets (set with: sf env set NAME)
# These are NOT read from this file at runtime — it documents what to configure.

# Seed the first admin (comma-separated emails auto-approved + made admin on signup)
ADMIN_EMAILS=you@example.com

# Source sync trigger secret (POST/GET /api/sync)
SYNC_SECRET=change-me

# Optional: LLM for Perfect Game sync + AI jersey tagging (any OpenAI-compatible API)
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini

# Optional: self-serve password-reset emails
RESEND_API_KEY=
RESET_FROM_EMAIL=noreply@example.com
